From: Daniel Pawlik <pawlik.dan@gmail.com>
Subject: [DEBUG] net: airoha: npu: instrument mailbox DMA path

Debug instrumentation for EN7581 NPU mailbox DMA regression.
Traces buffer alignment, SWIOTLB bounce, pre/post-unmap buffer
contents, direct bounce-buffer read with cache invalidation, and
original-buffer physical memory read to check if NPU writes response
to original address instead of bounce address. Logs device DMA mask
and buffer physical address to diagnose why swiotlb bounce persists.

NOT FOR MERGE — debug only.

Signed-off-by: Daniel Pawlik <pawlik.dan@gmail.com>

---
 drivers/net/ethernet/airoha/airoha_npu.c | 75 +++++++++++++++++++++++
 1 file changed, 75 insertions(+)

--- a/drivers/net/ethernet/airoha/airoha_npu.c
+++ b/drivers/net/ethernet/airoha/airoha_npu.c
@@ -5,6 +5,10 @@
  */

 #include <linux/devcoredump.h>
+#include <asm/cacheflush.h>
+#include <linux/dma-direct.h>
+#include <linux/dma-mapping.h>
+#include <linux/swiotlb.h>
 #include <linux/firmware.h>
 #include <linux/platform_device.h>
 #include <linux/of_net.h>
@@ -165,16 +169,41 @@ static int airoha_npu_send_msg(struct ai
 {
 	u16 core = 0; /* FIXME */
 	u32 val, offset = core << 4;
+	unsigned long cache_align = dma_get_cache_alignment();
 	dma_addr_t dma_addr;
 	int ret;

+	dev_info(npu->dev,
+		 "[NPU-DMA] func_id=%d p=%px phys=%pa size=%d cache_align=%lu p_aligned=%d size_aligned=%d dma_mask=0x%llx\n",
+		 func_id, p, &(phys_addr_t){virt_to_phys(p)}, size, cache_align,
+		 IS_ALIGNED((unsigned long)p, cache_align),
+		 IS_ALIGNED(size, cache_align),
+		 *npu->dev->dma_mask);
+
+	print_hex_dump(KERN_INFO, "[NPU-DMA] pre-map: ", DUMP_PREFIX_OFFSET,
+		       16, 1, p, min_t(int, size, 32), true);
+
 	dma_addr = dma_map_single(npu->dev, p, size, DMA_BIDIRECTIONAL);
 	ret = dma_mapping_error(npu->dev, dma_addr);
-	if (ret)
+	if (ret) {
+		dev_err(npu->dev, "[NPU-DMA] dma_map_single FAILED: %d\n", ret);
 		return ret;
+	}
+
+	dev_info(npu->dev,
+		 "[NPU-DMA] mapped: dma=%pad dma_aligned=%d is_swiotlb=%d\n",
+		 &dma_addr,
+		 IS_ALIGNED(dma_addr, cache_align),
+		 !!swiotlb_find_pool(npu->dev, dma_to_phys(npu->dev, dma_addr)));

 	spin_lock_bh(&npu->cores[core].lock);

+	/*
+	 * Explicitly sync before NPU reads — should be redundant after
+	 * dma_map_single(BIDIRECTIONAL) but log whether it changes anything.
+	 */
+	dma_sync_single_for_device(npu->dev, dma_addr, size, DMA_BIDIRECTIONAL);
+
 	regmap_write(npu->regmap, REG_CR_MBQ0_CTRL(0) + offset, dma_addr);
 	regmap_write(npu->regmap, REG_CR_MBQ0_CTRL(1) + offset, size);
 	regmap_read(npu->regmap, REG_CR_MBQ0_CTRL(2) + offset, &val);
@@ -189,10 +218,56 @@ static int airoha_npu_send_msg(struct ai
 	if (!ret && FIELD_GET(MBOX_MSG_STATUS, val) != NPU_MBOX_SUCCESS)
 		ret = -EINVAL;

+	dev_info(npu->dev, "[NPU-DMA] mbox done: ret=%d mbox_status=0x%x\n",
+		 ret, val);
+
 	spin_unlock_bh(&npu->cores[core].lock);

+	/*
+	 * Read bounce buffer DIRECTLY before swiotlb copies back.
+	 * Invalidate CPU cache first — bounce was cached during map.
+	 * Use cache-line-aligned range so dcache_inval_poc does pure
+	 * invalidate (no clean-writeback of stale data).
+	 */
+	{
+		phys_addr_t bounce_phys = dma_to_phys(npu->dev, dma_addr);
+		void *bounce_virt = phys_to_virt(bounce_phys);
+		unsigned long inv_start = (unsigned long)bounce_virt & ~63UL;
+		unsigned long inv_end = ALIGN((unsigned long)bounce_virt + size, 64);
+
+		dcache_inval_poc(inv_start, inv_end);
+
+		dev_info(npu->dev,
+			 "[NPU-DMA] bounce phys=%pa virt=%px (orig p=%px)\n",
+			 &bounce_phys, bounce_virt, p);
+		print_hex_dump(KERN_INFO, "[NPU-DMA] bounce-direct: ",
+			       DUMP_PREFIX_OFFSET, 16, 1, bounce_virt,
+			       min_t(int, size, 32), true);
+	}
+
+	/* Check if NPU wrote to original buffer's physical address instead */
+	{
+		unsigned long orig_start = (unsigned long)p & ~63UL;
+		unsigned long orig_end = ALIGN((unsigned long)p + size, 64);
+
+		dcache_inval_poc(orig_start, orig_end);
+
+		print_hex_dump(KERN_INFO, "[NPU-DMA] orig-nocache: ",
+			       DUMP_PREFIX_OFFSET, 16, 1, p,
+			       min_t(int, size, 32), true);
+	}
+
+	/* Sync for CPU before unmap — see if explicit sync changes result */
+	dma_sync_single_for_cpu(npu->dev, dma_addr, size, DMA_BIDIRECTIONAL);
+
+	print_hex_dump(KERN_INFO, "[NPU-DMA] post-sync pre-unmap: ",
+		       DUMP_PREFIX_OFFSET, 16, 1, p, min_t(int, size, 32), true);
+
 	dma_unmap_single(npu->dev, dma_addr, size, DMA_BIDIRECTIONAL);

+	print_hex_dump(KERN_INFO, "[NPU-DMA] post-unmap: ", DUMP_PREFIX_OFFSET,
+		       16, 1, p, min_t(int, size, 32), true);
+
 	return ret;
 }

