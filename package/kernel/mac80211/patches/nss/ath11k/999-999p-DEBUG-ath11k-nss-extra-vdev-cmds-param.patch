+/*
+ * E101: wyslij SUROWA komende do VAP-a (numer komendy prosto z enum
+ * nss_wifi_vdev_cmd, bez mapowania ath11k). Sluzy do odtwarzania komend,
+ * ktorych ath11k w ogole nie zna - np. CFG_AST_OVERRIDE (16), ktore stock
+ * (osif_nss_vdev_set_cfg, galaz idx16) wysyla ze stala wartoscia 1.
+ */
+static void ath11k_nss_vdev_send_raw_cmd(struct ath11k_vif *arvif, u32 cmd, u32 val)
+{
+	struct nss_wifi_vdev_msg *vdev_msg;
+	struct nss_wifi_vdev_cmd_msg *vdev_cmd;
+	struct ath11k *ar = arvif->ar;
+	nss_tx_status_t status;
+
+	vdev_msg = kzalloc(sizeof(*vdev_msg), GFP_ATOMIC);
+	if (!vdev_msg)
+		return;
+
+	vdev_cmd = &vdev_msg->msg.vdev_cmd;
+	vdev_cmd->cmd = cmd;
+	vdev_cmd->value = val;
+
+	nss_wifi_vdev_msg_init(vdev_msg, arvif->nss.if_num,
+			       NSS_WIFI_VDEV_INTERFACE_CMD_MSG,
+			       sizeof(struct nss_wifi_vdev_cmd_msg),
+			       NULL, NULL);
+
+	status = nss_wifi_vdev_tx_msg(ar->nss.ctx, vdev_msg);
+	pr_info("nss-extra-cmd: if=%d cmd=%u value=%u status=%d\n",
+		arvif->nss.if_num, cmd, val, status);
+
+	kfree(vdev_msg);
+}
+
+/*
+ * E101: rozbierz parametr "cmd:value,cmd:value" i wyslij po IF_UP.
+ */
+static void ath11k_nss_vdev_extra_cmds(struct ath11k_vif *arvif)
+{
+	const char *p = nss_vdev_extra_cmds;
+
+	if (!p || !*p)
+		return;
+
+	while (*p) {
+		unsigned int cmd = 0, val = 0;
+		int consumed = 0;
+
+		if (sscanf(p, "%u:%u%n", &cmd, &val, &consumed) != 2) {
+			pr_info("nss-extra-cmd: nie umiem rozebrac \"%s\"\n", p);
+			return;
+		}
+
+		if (cmd >= NSS_WIFI_VDEV_MAX_CMD) {
+			pr_info("nss-extra-cmd: cmd=%u poza zakresem\n", cmd);
+			return;
+		}
+
+		ath11k_nss_vdev_send_raw_cmd(arvif, cmd, val);
+
+		p += consumed;
+		if (*p == ',')
+			p++;
+	}
+}
+
