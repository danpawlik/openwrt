From: Claude <noreply@anthropic.com>
Subject: [PATCH] DEBUG: ath11k: nss: on demand dump of the DP ring state (E78)

E78. The whole host->NSS control surface is proven equivalent to stock
(journal 2026-08-22) and the wifili node still moves no data. Two
hypotheses remain and this probe decides between them without any
cooperation from either firmware:

  (a) the wifili node in the NSS blob never runs its datapath - then
      every ring it owns as producer stays at its init value: the TCL
      data ring HP never moves after the host hands it frames, and the
      RXDMA refill ring stays unreplenished;
  (b) wifili produces into TCL but the WLAN firmware never consumes -
      then TCL HP moves while the WCSS TQM counters (E74) stay zero.

The rings live in host DMA memory and the HP/TP registers are readable
through ab->mem, so a plain read shows who has written what. For source
rings HP is the producer register and TP the host-memory shadow the
consumer updates; for destination rings the roles are swapped.

  echo 1 > /sys/module/ath11k/parameters/ring_probe && dmesg | grep ring-probe

Run it once right after wifi comes up (baseline) and once after frames
were handed to wifili, and diff. MUST be run while the WLAN firmware is
alive (< ~450 s after modprobe, bug#2): the UMAC HP/TP registers are in
the WCSS power domain and reading them after the Q6 died raises the
synchronous external abort already seen from the debugfs stats dump.

--- a/drivers/net/wireless/ath/ath11k/nss.c
+++ b/drivers/net/wireless/ath/ath11k/nss.c
@@ -23,6 +23,177 @@
 module_param(nss_init_stage, uint, 0644);
 MODULE_PARM_DESC(nss_init_stage, "wifili bring-up stage limit (debug bisection)");
 
+
+/* DEBUG E78: on demand dump of the DP ring state - the rings live in host
+ * DMA memory and the HP/TP registers are readable through ab->mem, so a
+ * plain read shows who has written what without asking either firmware.
+ * MUST run while the WLAN fw is alive (< ~450 s after modprobe, bug#2).
+ */
+static struct ath11k_base *ath11k_ring_probe_ab;
+
+/* Read a ring pointer only when it clearly lies in host coherent memory
+ * (the shadow rdp/wrp pages) or inside the mapped register window; print
+ * the raw pointer instead of dereferencing anything else.
+ */
+static u32 ath11k_ring_probe_read(struct ath11k_base *ab, u32 *addr)
+{
+	unsigned long a = (unsigned long)addr;
+	unsigned long mem = (unsigned long)ab->mem;
+	struct ath11k_hal *hal = &ab->hal;
+
+	if (!addr)
+		return 0xdead;
+
+	if (a >= (unsigned long)hal->rdp.vaddr &&
+	    a < (unsigned long)hal->rdp.vaddr + HAL_SRNG_RING_ID_MAX * 4)
+		return *(volatile u32 *)addr;
+	if (a >= (unsigned long)hal->wrp.vaddr &&
+	    a < (unsigned long)hal->wrp.vaddr + HAL_SRNG_RING_ID_MAX * 4)
+		return *(volatile u32 *)addr;
+	if (a >= mem && a < mem + ab->mem_len)
+		return *(volatile u32 *)addr;
+
+	pr_info("ring-probe: pointer %lx outside mem %lx+%lx - skipped\n",
+		a, mem, ab->mem_len);
+	return 0xbadd;
+}
+
+static void ath11k_nss_ring_probe_one(struct ath11k_base *ab, const char *name,
+				      int ring_id)
+{
+	struct hal_srng *srng;
+	u32 hp, tp, nonzero = 0, words, last_nz = 0;
+	u32 *v;
+	int i;
+
+	if (ring_id < 0) {
+		pr_info("ring-probe: %s: invalid ring_id\n", name);
+		return;
+	}
+
+	srng = &ab->hal.srng_list[ring_id];
+	if (!srng->initialized || !srng->ring_base_vaddr) {
+		pr_info("ring-probe: %s: id=%d not initialized\n", name, ring_id);
+		return;
+	}
+
+	if (srng->ring_dir == HAL_SRNG_DIR_SRC) {
+		hp = ath11k_ring_probe_read(ab, srng->u.src_ring.hp_addr);
+		tp = ath11k_ring_probe_read(ab, srng->u.src_ring.tp_addr);
+	} else {
+		hp = ath11k_ring_probe_read(ab, srng->u.dst_ring.hp_addr);
+		tp = ath11k_ring_probe_read(ab, srng->u.dst_ring.tp_addr);
+	}
+
+	v = srng->ring_base_vaddr;
+	words = srng->num_entries * srng->entry_size;
+	for (i = 0; i < words; i++) {
+		if (v[i]) {
+			nonzero++;
+			last_nz = i;
+		}
+	}
+
+	pr_info("ring-probe: %-12s id=%3d dir=%s entries=%u esize=%u hp=%u tp=%u nonzero=%u/%u last_nz=%u\n",
+		name, ring_id,
+		srng->ring_dir == HAL_SRNG_DIR_SRC ? "src" : "dst",
+		srng->num_entries, srng->entry_size, hp, tp,
+		nonzero, words, last_nz);
+
+	/* E81: first entry of the ring with the buffer_addr_info decoded.
+	 * word1 carries RET_BUF_MGR in bits 10:8 and the sw cookie in 31:11
+	 * (BUFFER_ADDR_INFO1_*), so this shows which return buffer manager
+	 * the descriptors in this ring are actually tagged with.
+	 */
+	if (words >= 2)
+		pr_info("ring-probe: %-12s ent0: %08x %08x rbm=%u cookie=0x%x\n",
+			name, v[0], v[1], (v[1] >> 8) & 0x7, v[1] >> 11);
+
+	/* E82: a buffer ring (2 word entries) must carry a UNIQUE sw cookie
+	 * per entry - the firmware uses it to find the buffer again. Count how
+	 * many entries differ from entry 0 and show the first few, so a ring
+	 * filled with a constant descriptor is immediately visible.
+	 */
+	if (srng->entry_size == 2 && srng->num_entries > 8) {
+		u32 diff = 0;
+
+		for (i = 1; i < srng->num_entries; i++)
+			if (v[i * 2 + 1] != v[1])
+				diff++;
+
+		pr_info("ring-probe: %-12s cookies: %u/%u entries differ from ent0; c0=0x%x c1=0x%x c2=0x%x c3=0x%x\n",
+			name, diff, srng->num_entries - 1,
+			v[1] >> 11, v[3] >> 11, v[5] >> 11, v[7] >> 11);
+	}
+
+	/* the entry just below HP - for a source ring that is the descriptor
+	 * the producer wrote most recently
+	 */
+	if (nonzero && srng->entry_size) {
+		u32 ent = hp / srng->entry_size;
+		u32 n;
+
+		ent = (ent + srng->num_entries - 1) % srng->num_entries;
+		i = ent * srng->entry_size;
+		n = words - i;
+		if (n > 8)
+			n = 8;
+		if (n >= 2)
+			pr_info("ring-probe: %-12s ent[%u]: %08x %08x rbm=%u cookie=0x%x\n",
+				name, ent, v[i], v[i + 1],
+				(v[i + 1] >> 8) & 0x7, v[i + 1] >> 11);
+	}
+}
+
+static void ath11k_nss_ring_probe(struct ath11k_base *ab)
+{
+	struct ath11k_pdev_dp *dp;
+	char name[24];
+	int i;
+
+	pr_info("ring-probe: === DP ring state ===\n");
+
+	for (i = 0; i < DP_TCL_NUM_RING_MAX; i++) {
+		snprintf(name, sizeof(name), "tcl_data%d", i);
+		ath11k_nss_ring_probe_one(ab, name,
+					  ab->dp.tx_ring[i].tcl_data_ring.ring_id);
+		snprintf(name, sizeof(name), "tcl_comp%d", i);
+		ath11k_nss_ring_probe_one(ab, name,
+					  ab->dp.tx_ring[i].tcl_comp_ring.ring_id);
+	}
+
+	for (i = 0; i < DP_REO_DST_RING_MAX; i++) {
+		snprintf(name, sizeof(name), "reo_dst%d", i);
+		ath11k_nss_ring_probe_one(ab, name,
+					  ab->dp.reo_dst_ring[i].ring_id);
+	}
+
+	ath11k_nss_ring_probe_one(ab, "rx_rel", ab->dp.rx_rel_ring.ring_id);
+	ath11k_nss_ring_probe_one(ab, "reo_reinject",
+				  ab->dp.reo_reinject_ring.ring_id);
+	ath11k_nss_ring_probe_one(ab, "reo_except",
+				  ab->dp.reo_except_ring.ring_id);
+
+	if (ab->pdevs[0].ar) {
+		dp = &ab->pdevs[0].ar->dp;
+		ath11k_nss_ring_probe_one(ab, "rxdma_refill",
+			dp->rx_refill_buf_ring.refill_buf_ring.ring_id);
+		ath11k_nss_ring_probe_one(ab, "rxdma_err0",
+			dp->rxdma_err_dst_ring[0].ring_id);
+	}
+}
+
+static int ath11k_ring_probe_set(const char *val, const struct kernel_param *kp)
+{
+	if (ath11k_ring_probe_ab)
+		ath11k_nss_ring_probe(ath11k_ring_probe_ab);
+	else
+		pr_info("ring-probe: no soc registered\n");
+	return 0;
+}
+module_param_call(ring_probe, ath11k_ring_probe_set, NULL, NULL, 0200);
+MODULE_PARM_DESC(ring_probe, "dump DP ring state to dmesg (debug)");
+
 /*-----------------------------ATH11K-NSS Helpers--------------------------*/
 
 static enum ath11k_nss_opmode
@@ -3750,6 +3921,13 @@
 		return 0;
 	}
 
+	/* DEBUG E78v2: store the handle only for the soc that really runs
+	 * wifili - on B3000 nss_setup() is entered for the QCN6122 ab too,
+	 * and probing that ab reads registers beyond its smaller window
+	 * (E78 crash: TCL1_HP 0xa46000 unmapped on the 6122 ab).
+	 */
+	ath11k_ring_probe_ab = ab;
+
 	/* Verify NSS support is enabled */
 	if (nss_cmn_get_nss_enabled() == false) {
 		ath11k_warn(ab, "NSS offload support disabled, falling back to default mode\n");
