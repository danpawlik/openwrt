From: Chad Monroe <chad@monroe.io>
Date: Mon, 01 Sep 2025 06:42:10 -0700
Subject: [PATCH] thermal/drivers/mediatek/lvts_thermal: Add irq_enable
 support.

Allow interrupt support to be disabled as some SoCs don't support it.

Signed-off-by: Chad Monroe <chad@monroe.io>
---
 drivers/thermal/mediatek/lvts_thermal.c |   33 ++++++++++++++++------
 1 file changed, 25 insertions(+), 8 deletions(-)

--- a/drivers/thermal/mediatek/lvts_thermal.c	2026-10-30 13:09:52.000000000 +0100
+++ b/drivers/thermal/mediatek/lvts_thermal.c	2026-10-30 20:55:33.057022438 +0100
@@ -151,6 +151,7 @@
 	const struct lvts_platform_ops *ops;
 	const u32 *conn_cmd;
 	const u32 *init_cmd;
+	bool irq_enable;
 	int num_cal_offsets;
 	int num_lvts_ctrl;
 	int num_conn_cmd;
@@ -458,6 +459,10 @@
 		lvts_ctrl->high_thresh = high;
 		lvts_ctrl->low_thresh = low;
 	}
+
+	if (!lvts_data->irq_enable)
+		return 0;
+
 	lvts_update_irq_mask(lvts_ctrl);
 
 	if (!should_update_thresh)
@@ -1046,6 +1051,8 @@
 
 static int lvts_irq_init(struct lvts_ctrl *lvts_ctrl)
 {
+	const struct lvts_data *lvts_data = lvts_ctrl->lvts_data;
+
 	/*
 	 * LVTS_PROTCTL : Thermal Protection Sensor Selection
 	 *
@@ -1079,7 +1086,8 @@
 	 * The LVTS_MONINT register layout is the same as the LVTS_MONINTSTS
 	 * register, except we set the bits to enable the interrupt.
 	 */
-	writel(0, LVTS_MONINT(lvts_ctrl->base));
+	if (lvts_data->irq_enable)
+		writel(0, LVTS_MONINT(lvts_ctrl->base));
 
 	return 0;
 }
@@ -1487,9 +1495,11 @@
 	if (IS_ERR(lvts_td->reset))
 		return dev_err_probe(dev, PTR_ERR(lvts_td->reset), "Failed to get reset control\n");
 
-	irq = platform_get_irq(pdev, 0);
-	if (irq < 0)
-		return irq;
+	if (lvts_data->irq_enable) {
+		irq = platform_get_irq(pdev, 0);
+		if (irq < 0)
+			return irq;
+	}
 
 	golden_temp_offset = lvts_data->temp_offset;
 
@@ -1501,10 +1511,12 @@
 	 * At this point the LVTS is initialized and enabled. We can
 	 * safely enable the interrupt.
 	 */
-	ret = devm_request_threaded_irq(dev, irq, NULL, lvts_irq_handler,
-					IRQF_ONESHOT, dev_name(dev), lvts_td);
-	if (ret)
-		return ret;
+	if (lvts_data->irq_enable) {
+		ret = devm_request_threaded_irq(dev, irq, NULL, lvts_irq_handler,
+						IRQF_ONESHOT, dev_name(dev), lvts_td);
+		if (ret)
+			return dev_err_probe(dev, ret, "Failed to request interrupt\n");
+	}
 
 	platform_set_drvdata(pdev, lvts_td);
 
@@ -2042,6 +2054,7 @@
 };
 
 static const struct lvts_data mt7988_lvts_ap_data = {
+	.irq_enable	= true,
 	.lvts_ctrl	= mt7988_lvts_ap_data_ctrl,
 	.conn_cmd	= mt7988_conn_cmds,
 	.init_cmd	= mt7988_init_cmds,
@@ -2056,6 +2069,7 @@
 };
 
 static const struct lvts_data mt8186_lvts_data = {
+	.irq_enable	= true,
 	.lvts_ctrl	= mt8186_lvts_data_ctrl,
 	.conn_cmd	= default_conn_cmds,
 	.init_cmd	= default_init_cmds,
@@ -2071,6 +2085,7 @@
 };
 
 static const struct lvts_data mt8188_lvts_mcu_data = {
+	.irq_enable	= true,
 	.lvts_ctrl	= mt8188_lvts_mcu_data_ctrl,
 	.conn_cmd	= default_conn_cmds,
 	.init_cmd	= default_init_cmds,
@@ -2086,6 +2101,7 @@
 };
 
 static const struct lvts_data mt8188_lvts_ap_data = {
+	.irq_enable	= true,
 	.lvts_ctrl	= mt8188_lvts_ap_data_ctrl,
 	.conn_cmd	= default_conn_cmds,
 	.init_cmd	= default_init_cmds,
@@ -2101,6 +2117,7 @@
 };
 
 static const struct lvts_data mt8192_lvts_mcu_data = {
+	.irq_enable	= true,
 	.lvts_ctrl	= mt8192_lvts_mcu_data_ctrl,
 	.conn_cmd	= default_conn_cmds,
 	.init_cmd	= default_init_cmds,
@@ -2116,6 +2133,7 @@
 };
 
 static const struct lvts_data mt8192_lvts_ap_data = {
+	.irq_enable	= true,
 	.lvts_ctrl	= mt8192_lvts_ap_data_ctrl,
 	.conn_cmd	= default_conn_cmds,
 	.init_cmd	= default_init_cmds,
@@ -2131,6 +2149,7 @@
 };
 
 static const struct lvts_data mt8195_lvts_mcu_data = {
+	.irq_enable	= true,
 	.lvts_ctrl	= mt8195_lvts_mcu_data_ctrl,
 	.conn_cmd	= default_conn_cmds,
 	.init_cmd	= default_init_cmds,
@@ -2146,6 +2165,7 @@
 };
 
 static const struct lvts_data mt8195_lvts_ap_data = {
+	.irq_enable	= true,
 	.lvts_ctrl	= mt8195_lvts_ap_data_ctrl,
 	.conn_cmd	= default_conn_cmds,
 	.init_cmd	= default_init_cmds,
