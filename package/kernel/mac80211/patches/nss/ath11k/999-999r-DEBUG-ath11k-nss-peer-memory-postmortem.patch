+/*
+ * E105: sekcja zwlok pamieci peera.
+ *
+ * PEER_CREATE oddaje firmware'owi 1600 B pamieci HOSTA (kzalloc + dma_map)
+ * i to tam wifili trzyma swoj stan per peer - w DDR rdzenia NSS adresu MAC
+ * klienta nie ma w ogole (przeskanowane), wiec albo OCM, albo wlasnie ten
+ * bufor. Bufor jest nasz, wiec da sie go przeczytac takze wtedy, gdy rdzen
+ * juz nie odpowiada.
+ *
+ * nss_peer_keep=1  - nie zwalniaj bufora przy PEER_DELETE (przetrwa zgon)
+ * nss_peer_dump=N  - wypisz N bajtow kazdego zapamietanego bufora
+ */
+static unsigned int nss_peer_keep;
+module_param(nss_peer_keep, uint, 0644);
+MODULE_PARM_DESC(nss_peer_keep, "E105: keep the per-peer NSS buffer alive after peer delete");
+
+#define ATH11K_NSS_PEER_DBG_MAX 4
+static struct {
+	void *vaddr;
+	dma_addr_t paddr;
+	u8 mac[ETH_ALEN];
+	u16 peer_id;
+} ath11k_nss_peer_dbg[ATH11K_NSS_PEER_DBG_MAX];
+static unsigned int ath11k_nss_peer_dbg_n;
+
+static int ath11k_nss_peer_dump_set(const char *val, const struct kernel_param *kp)
+{
+	unsigned int len;
+	int ret, i;
+
+	ret = kstrtouint(val, 0, &len);
+	if (ret)
+		return ret;
+
+	if (!len)
+		len = 256;
+	if (len > WIFILI_NSS_PEER_BYTE_SIZE)
+		len = WIFILI_NSS_PEER_BYTE_SIZE;
+
+	for (i = 0; i < ATH11K_NSS_PEER_DBG_MAX; i++) {
+		if (!ath11k_nss_peer_dbg[i].vaddr)
+			continue;
+
+		pr_info("nss-peer-mem: slot=%d id=%u mac=%pM paddr=0x%llx len=%u\n",
+			i, ath11k_nss_peer_dbg[i].peer_id, ath11k_nss_peer_dbg[i].mac,
+			(unsigned long long)ath11k_nss_peer_dbg[i].paddr, len);
+		print_hex_dump(KERN_ERR, "nss-peer: ", DUMP_PREFIX_OFFSET, 32, 4,
+			       ath11k_nss_peer_dbg[i].vaddr, len, false);
+	}
+
+	return 0;
+}
+
+static const struct kernel_param_ops ath11k_nss_peer_dump_ops = {
+	.set = ath11k_nss_peer_dump_set,
+};
+module_param_cb(nss_peer_dump, &ath11k_nss_peer_dump_ops, NULL, 0644);
+MODULE_PARM_DESC(nss_peer_dump, "E105: hexdump the remembered per-peer NSS buffers");
