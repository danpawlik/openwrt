From: Daniel Pawlik <pawlik.dan@gmail.com>
Subject: [DEBUG] net: airoha: npu: use cache-line-aligned DMA buffer

Use kmalloc'd cache-line-aligned buffer for mailbox DMA to bypass
swiotlb bounce on non-coherent ARM64. Tests whether NPU can write
responses via streaming DMA when the buffer size is properly aligned
(eliminating the unaligned-length swiotlb bounce path).

NOT FOR MERGE — debug only.

Signed-off-by: Daniel Pawlik <pawlik.dan@gmail.com>

---
 drivers/net/ethernet/airoha/airoha_npu.c | 55 ++++++++++++++++++++---
 1 file changed, 49 insertions(+), 6 deletions(-)

--- a/drivers/net/ethernet/airoha/airoha_npu.c
+++ b/drivers/net/ethernet/airoha/airoha_npu.c
@@ -5,6 +5,10 @@
  */

 #include <linux/devcoredump.h>
+#include <asm/cacheflush.h>
+#include <linux/dma-direct.h>
+#include <linux/dma-mapping.h>
+#include <linux/swiotlb.h>
 #include <linux/firmware.h>
 #include <linux/platform_device.h>
 #include <linux/of_net.h>
@@ -165,13 +169,40 @@ static int airoha_npu_send_msg(struct ai
 {
 	u16 core = 0; /* FIXME */
 	u32 val, offset = core << 4;
+	unsigned long cache_align = dma_get_cache_alignment();
+	int aligned_size = ALIGN(size, cache_align);
 	dma_addr_t dma_addr;
+	void *dma_buf;
 	int ret;

-	dma_addr = dma_map_single(npu->dev, p, size, DMA_BIDIRECTIONAL);
+	dma_buf = kmalloc(aligned_size, GFP_KERNEL);
+	if (!dma_buf)
+		return -ENOMEM;
+
+	memcpy(dma_buf, p, size);
+	memset(dma_buf + size, 0, aligned_size - size);
+
+	dev_info(npu->dev,
+		 "[NPU-DMA] func_id=%d p=%px dma_buf=%px phys=%pa size=%d aligned_size=%d dma_mask=0x%llx\n",
+		 func_id, p, dma_buf, &(phys_addr_t){virt_to_phys(dma_buf)},
+		 size, aligned_size, *npu->dev->dma_mask);
+
+	print_hex_dump(KERN_INFO, "[NPU-DMA] pre-map: ", DUMP_PREFIX_OFFSET,
+		       16, 1, dma_buf, min_t(int, size, 32), true);
+
+	dma_addr = dma_map_single(npu->dev, dma_buf, aligned_size,
+				  DMA_BIDIRECTIONAL);
 	ret = dma_mapping_error(npu->dev, dma_addr);
-	if (ret)
+	if (ret) {
+		dev_err(npu->dev, "[NPU-DMA] dma_map_single FAILED: %d\n", ret);
+		kfree(dma_buf);
 		return ret;
+	}
+
+	dev_info(npu->dev,
+		 "[NPU-DMA] mapped: dma=%pad is_swiotlb=%d\n",
+		 &dma_addr,
+		 !!swiotlb_find_pool(npu->dev, dma_to_phys(npu->dev, dma_addr)));

 	spin_lock_bh(&npu->cores[core].lock);

@@ -189,9 +220,18 @@ static int airoha_npu_send_msg(struct ai
 	if (!ret && FIELD_GET(MBOX_MSG_STATUS, val) != NPU_MBOX_SUCCESS)
 		ret = -EINVAL;

+	dev_info(npu->dev, "[NPU-DMA] mbox done: ret=%d mbox_status=0x%x\n",
+		 ret, val);
+
 	spin_unlock_bh(&npu->cores[core].lock);

-	dma_unmap_single(npu->dev, dma_addr, size, DMA_BIDIRECTIONAL);
+	dma_unmap_single(npu->dev, dma_addr, aligned_size, DMA_BIDIRECTIONAL);
+
+	print_hex_dump(KERN_INFO, "[NPU-DMA] post-unmap: ", DUMP_PREFIX_OFFSET,
+		       16, 1, dma_buf, min_t(int, size, 32), true);
+
+	memcpy(p, dma_buf, size);
+	kfree(dma_buf);

 	return ret;
 }

