+/*
+ * E106: podglad bufora peera w locie.
+ *
+ * Rdzen ginie ~1-2 s po pierwszej wymianie unicast, a peer klienta zostaje
+ * z zerami w polach, ktore peer BSS ma wypelnione (+0x20, +0x24, +0x34).
+ * Nie wiadomo, czy firmware ich nie ustawil, czy tylko nie zdazyl odlozyc
+ * stanu z OCM do naszego bufora.  Ten timer czyta bufory co kilkadziesiat
+ * milisekund i wypisuje KAZDA zmiane slowa - ostatni wpis przed cisza to
+ * ostatnia rzecz, jaka firmware zdazyl zapisac.
+ *
+ * echo 50 > /sys/module/ath11k/parameters/nss_peer_watch   (ms; 0 = stop)
+ */
+static struct ath11k_base *ath11k_nss_watch_ab;
+static u32 *ath11k_nss_watch_copy[ATH11K_NSS_PEER_DBG_MAX];
+static unsigned int ath11k_nss_watch_ms;
+static unsigned int ath11k_nss_watch_tick;
+static void ath11k_nss_peer_watch_work(struct work_struct *work);
+static DECLARE_DELAYED_WORK(ath11k_nss_watch_dwork, ath11k_nss_peer_watch_work);
+
+static void ath11k_nss_peer_watch_work(struct work_struct *work)
+{
+	unsigned int words = WIFILI_NSS_PEER_BYTE_SIZE / sizeof(u32);
+	unsigned int i, w, changed = 0;
+
+	ath11k_nss_watch_tick++;
+
+	for (i = 0; i < ATH11K_NSS_PEER_DBG_MAX; i++) {
+		u32 *cur = ath11k_nss_peer_dbg[i].vaddr;
+		u32 *old = ath11k_nss_watch_copy[i];
+
+		if (!cur)
+			continue;
+
+		/*
+		 * E106 fix: peer klienta pojawia sie DOPIERO po starcie
+		 * podgladu - zaloz mu kopie odniesienia w locie, inaczej
+		 * nigdy nie zostanie zauwazony (tak przepadl pierwszy przebieg).
+		 */
+		if (!old) {
+			old = kzalloc(WIFILI_NSS_PEER_BYTE_SIZE, GFP_ATOMIC);
+			if (!old)
+				continue;
+			ath11k_nss_watch_copy[i] = old;
+			pr_info("nss-peer-watch: t=%u nowy slot=%u mac=%pM (start obserwacji)\n",
+				ath11k_nss_watch_tick, i, ath11k_nss_peer_dbg[i].mac);
+		}
+
+		if (ath11k_nss_watch_ab)
+			dma_sync_single_for_cpu(ath11k_nss_watch_ab->dev,
+						ath11k_nss_peer_dbg[i].paddr,
+						WIFILI_NSS_PEER_BYTE_SIZE,
+						DMA_FROM_DEVICE);
+
+		for (w = 0; w < words; w++) {
+			if (cur[w] == old[w])
+				continue;
+
+			if (changed < 24)
+				pr_info("nss-peer-watch: t=%u slot=%u +0x%03x %08x -> %08x\n",
+					ath11k_nss_watch_tick, i,
+					(unsigned int)(w * sizeof(u32)),
+					old[w], cur[w]);
+			old[w] = cur[w];
+			changed++;
+		}
+	}
+
+	if (changed >= 24)
+		pr_info("nss-peer-watch: t=%u ... i %u dalszych zmian\n",
+			ath11k_nss_watch_tick, changed - 24);
+
+	if (ath11k_nss_watch_ms)
+		schedule_delayed_work(&ath11k_nss_watch_dwork,
+				      msecs_to_jiffies(ath11k_nss_watch_ms));
+}
+
+static int ath11k_nss_peer_watch_set(const char *val, const struct kernel_param *kp)
+{
+	unsigned int ms;
+	int ret, i;
+
+	ret = kstrtouint(val, 0, &ms);
+	if (ret)
+		return ret;
+
+	ath11k_nss_watch_ms = ms;
+
+	if (!ms) {
+		cancel_delayed_work_sync(&ath11k_nss_watch_dwork);
+		pr_info("nss-peer-watch: stop (tick=%u)\n", ath11k_nss_watch_tick);
+		return 0;
+	}
+
+	for (i = 0; i < ATH11K_NSS_PEER_DBG_MAX; i++) {
+		if (!ath11k_nss_peer_dbg[i].vaddr)
+			continue;
+		if (!ath11k_nss_watch_copy[i]) {
+			ath11k_nss_watch_copy[i] = kzalloc(WIFILI_NSS_PEER_BYTE_SIZE, GFP_KERNEL);
+			if (!ath11k_nss_watch_copy[i])
+				return -ENOMEM;
+		}
+		memcpy(ath11k_nss_watch_copy[i], ath11k_nss_peer_dbg[i].vaddr,
+		       WIFILI_NSS_PEER_BYTE_SIZE);
+	}
+
+	ath11k_nss_watch_tick = 0;
+	pr_info("nss-peer-watch: start co %u ms\n", ms);
+	schedule_delayed_work(&ath11k_nss_watch_dwork, msecs_to_jiffies(ms));
+	return 0;
+}
+
+static const struct kernel_param_ops ath11k_nss_peer_watch_ops = {
+	.set = ath11k_nss_peer_watch_set,
+};
+module_param_cb(nss_peer_watch, &ath11k_nss_peer_watch_ops, NULL, 0644);
+MODULE_PARM_DESC(nss_peer_watch, "E106: poll the per-peer NSS buffers every N ms and log every change");
