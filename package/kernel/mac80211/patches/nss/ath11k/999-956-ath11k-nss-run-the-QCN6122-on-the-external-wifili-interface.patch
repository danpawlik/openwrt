+/* E148: the NSS firmware addresses this radio's ring registers through
+ * the same static windows the host does (UMAC in window 1, CE in window
+ * 2 - see ath11k_ahb_config_static_window_qcn6122()), so the offsets
+ * handed to it in the wifili init message must be window-relative.
+ * Without this hook ath11k_hif_get_window_offset() returns the raw
+ * register offset, which lies outside the mapped range, and the firmware
+ * programs rings that do not exist.
+ */
+static u32 ath11k_ahb_get_window_offset_qcn6122(struct ath11k_base *ab,
+						 u32 offset)
+{
+	u32 window_start = ath11k_ahb_get_window_start_wcn6750(ab, offset);
+
+	if (window_start)
+		offset = window_start + (offset & ATH11K_PCI_WINDOW_RANGE_MASK);
+
+	return offset;
+}
