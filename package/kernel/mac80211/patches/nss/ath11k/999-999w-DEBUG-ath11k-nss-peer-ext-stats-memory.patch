+ * Firmware MP zapisuje ten wskaznik do swojej struktury peera i siega po
+ * niego przy PIERWSZEJ ramce od tego peera; przy zerze wychodzi z tego
+ * odczyt spod adresu 0, a Ubicom32 konczy taki dostep pulapka bez
+ * handlera ("Thread has non-recoverable trap") - watek ginie na stale,
+ * a za nim caly rdzen.
+ *
+ *   0 = jak dotad (nie podawaj nic)
+ *   1 = podaj adres, zostaw pext_stats_valid = 0
+ *   2 = podaj adres i ustaw pext_stats_valid = 1
+ */
+static unsigned int nss_pext = 1;
+module_param(nss_pext, uint, 0644);
+MODULE_PARM_DESC(nss_pext, "E121: give the firmware peer extended-stats memory (0=no, 1=addr only, 2=addr+valid)");
+
+#define ATH11K_NSS_PEXT_SIZE 4096
