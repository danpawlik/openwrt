+/* E148: an external wifili interface number is allocated from a pool of
+ * two (EXTERNAL_INTERFACE0/1) by nss_get_available_wifili_external_if()
+ * and is not freed by nss_unregister_wifili_if(). Without giving it back
+ * on teardown, the third init after two userPD recoveries finds the pool
+ * empty and the driver BUG()s. The internal interface is a fixed number
+ * and needs nothing.
+ */
+static void ath11k_nss_release_external_if(struct ath11k_base *ab)
+{
+	if (ab->nss.if_num == NSS_WIFILI_EXTERNAL_INTERFACE0 ||
+	    ab->nss.if_num == NSS_WIFILI_EXTERNAL_INTERFACE1)
+		nss_wifili_release_external_if(ab->nss.if_num);
+}
