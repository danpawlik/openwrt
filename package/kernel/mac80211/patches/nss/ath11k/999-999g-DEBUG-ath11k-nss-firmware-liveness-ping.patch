+/* DEBUG E55: uczciwy test zywotnosci firmware'u. Wysyla komunikat
+ * konfiguracji vdev, ktory WYMAGA potwierdzenia, i czeka na nie.
+ * Zwraca 0 gdy firmware odpowiedzial, -ETIMEDOUT gdy milczy.
+ * Powod: zadanie zrzutu (coredump) nie dziala w tym blobie NAWET na
+ * zywym firmwarze, wiec "brak odpowiedzi" nie dowodzil niczego.
+ */
+int ath11k_nss_ping_fw(struct ath11k *ar)
+{
+	struct ath11k_vif *arvif;
+	int ret = -ENODEV;
+
+	list_for_each_entry(arvif, &ar->arvifs, list) {
+		if (!arvif->nss.created)
+			continue;
+		ret = ath11k_nss_vdev_configure(arvif);
+		break;
+	}
+	pr_info("nss-ping: vdev_configure ret=%d (0 = fw odpowiedzial, -110 = milczy)\n",
+		ret);
+	return ret;
+}
